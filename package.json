{
  "name": "pied-piper",
  "private": true,
  "packageManager": "npm@11.13.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --filter=@rdi/core --filter=@rdi/web",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "desktop:dev": "npm run dev -w @rdi/web & npm run dev -w @rdi/desktop; kill %1",
    "desktop:build": "npm run build -w @rdi/desktop"
  },
  "devDependencies": {
    "turbo": "^2.11.5",
    "typescript": "~5.9.3"
  }
}
