---
import repo from '~/data/repo.json';
import { fill, STRINGS, type Lang } from '~/lib/strings';
const { lang } = Astro.props as { lang: Lang };
const s = STRINGS[lang];
const count = new Intl.NumberFormat(s.locale).format(repo.stars);
---
<section class="star-call" aria-labelledby="star-title">
  <svg class="star-icon" width="34" height="34" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.5l2.9 6 6.6.9-4.8 4.6 1.2 6.5L12 17.4l-5.9 3.1 1.2-6.5L2.5 9.4l6.6-.9z" /></svg>
  <div class="star-body">
    <h2 id="star-title">{s.starTitle}</h2>
    <p>{s.starText}</p>
  </div>
  <div class="star-actions">
    <a class="star-button" href={repo.url} target="_blank" rel="noopener" data-testid="star-github">★ {s.starButton}</a>
    {repo.stars > 0 && <span class="star-count">{fill(s.starCount, { count })}</span>}
  </div>
</section>
