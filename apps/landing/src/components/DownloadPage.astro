---
import manifest from '~/data/releases.json';
import { formatDate, formatSize, installerOf, latestOf, type Manifest } from '~/lib/releases';
import { fill, STORAGE_KEY, STRINGS, type Lang } from '~/lib/strings';
import FeatureGrid from './FeatureGrid.astro';
import LangSwitch from './LangSwitch.astro';
import StarCall from './StarCall.astro';
import '~/styles/global.css';

const { lang } = Astro.props as { lang: Lang };
const s = STRINGS[lang];
const data = manifest as Manifest;
const latest = latestOf(data.releases);
const installer = latest ? installerOf(latest) : null;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const alternates: { lang: Lang; href: string }[] = [{ lang: 'en', href: `${base}/` }, { lang: 'es', href: `${base}/es/` }];
const releasesUrl = import.meta.env.PUBLIC_RELEASES_URL ?? 'https://github.com/lennd/sessionboard-pied-piper/releases';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{s.title}</title>
    <meta name="description" content={s.description} />
    <link rel="icon" href={`${base}/mark.svg`} type="image/svg+xml" />
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.lang} href={alt.href} />)}
    <script is:inline define:vars={{ lang, base, storageKey: STORAGE_KEY }}>
      // Remember the language the visitor chose; on the English page, send Spanish browsers to /es/ the first time.
      const saved = localStorage.getItem(storageKey);
      const prefersEs = (navigator.languages || [navigator.language]).some((tag) => String(tag).toLowerCase().startsWith('es'));
      if (lang === 'en' && !saved && prefersEs) location.replace(`${base}/es/`);
      document.addEventListener('click', (event) => {
        const link = event.target instanceof Element ? event.target.closest('[data-lang]') : null;
        if (link) localStorage.setItem(storageKey, link.getAttribute('data-lang'));
      });
    </script>
  </head>
  <body>
    <LangSwitch lang={lang} />
    <main class="page">
      <header class="hero">
        <img class="mark" src={`${base}/mark.svg`} alt="" width="112" height="112" />
        <h1 class="wordmark">pied piper</h1>
        <p class="tagline">{s.tagline}</p>
        <div class="latest">
          {latest && installer ? (
            <>
              <a class="download" href={installer.url} download data-testid="download-latest">⤓ {fill(s.download, { version: latest.version })}</a>
              <div class="latest-meta"><span>{s.platform}</span><span>{formatSize(installer.size)}</span><span>{formatDate(latest.date, s.locale)}</span></div>
            </>
          ) : (
            <p class="muted">{latest ? s.noFiles : s.noVersions}</p>
          )}
        </div>
      </header>

      <section class="features-section" aria-labelledby="features-title">
        <h2 id="features-title">{s.featuresTitle}</h2>
        <FeatureGrid lang={lang} />
      </section>

      <StarCall lang={lang} />

      <section class="install" aria-labelledby="install-title">
        <h2 id="install-title">{s.installTitle}</h2>
        <ol class="steps">
          <li set:html={s.step1} />
          <li set:html={s.step2} />
          <li set:html={s.step3} />
        </ol>
      </section>
    </main>
    <footer class="foot">
      <span>{s.onlyMac}</span>
      <a class="foot-link" href={releasesUrl}>{s.allVersions} ↗</a>
      {data.generatedAt && <span class="muted">{fill(s.updated, { date: formatDate(data.generatedAt, s.locale) })}</span>}
    </footer>
  </body>
</html>
