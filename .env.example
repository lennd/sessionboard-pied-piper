# Local core (apps/core). Everything is optional.
RDI_PORT=4040
RDI_HOST=127.0.0.1
# Where the list of opened repositories and your preferences live (default ~/.rdi)
# RDI_HOME=/Users/you/.rdi
# Scripted agent for development and tests: no Claude Code calls, no tokens
RDI_FAKE_AGENT=false
# Claude Agent SDK options (uses the locally installed `claude` CLI and its login)
# AGENT_MODEL=claude-opus-5
AGENT_MAX_TURNS=16
# AGENT_MAX_BUDGET_USD=2
# CLAUDE_EXECUTABLE=/usr/local/bin/claude
